fn tables() -> parser.Tables = parser.Tables {
  ops: ops(),
  kids: kids(),
  spelling: spelling(),
  spelling_start: spelling_start(),
  spelling_end: spelling_end(),
  bucket_at: bucket_at(),
  bucket_next: bucket_next(),
